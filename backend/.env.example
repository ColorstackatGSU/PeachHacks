SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/peachhacks
SPRING_DATASOURCE_USERNAME=peachhacks
SPRING_DATASOURCE_PASSWORD=peachhacks

