SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/peachhacks
SPRING_DATASOURCE_USERNAME=peachhacks
SPRING_DATASOURCE_PASSWORD=peachhacks

# Supabase (transaction pooler)
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
# SPRING_DATASOURCE_PASSWORD=<database-password>

# Railway Postgres
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/railway
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<password>

# First admin account, created at startup when no admin with this email exists.
# The password must be 10 to 72 characters. Remove these once you have signed in
# and created real accounts if you prefer; existing accounts are never changed.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# Email (Resend). With the prod profile the application does not start without
# RESEND_API_KEY. Without the profile, an empty key means emails are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM=PeachHacks <hello@peachhacks.com>
# Used for links in emails (unsubscribe, ticket, school email confirmation) and for the
# ticket URL inside QR codes.
WEB_BASE_URL=https://www.peachhacks.com
ADMIN_BASE_URL=https://admin.peachhacks.com

# Google Wallet passes for accepted hackers. Optional: with any of the first three
# empty there is simply no "Add to Google Wallet" link. See README, "Google Wallet".
# The key is the service account's PEM private key; put it on one line with \n
# between the lines if your host does not accept multi-line values.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
# Suffix of the Event ticket class created in the Google Pay & Wallet Console.
# GOOGLE_WALLET_CLASS_ID=peachhacks_2027

# PeachBot: Discord verification for accepted hackers. Optional: with any of these empty
# the bot is off. See README, "PeachBot".
DISCORD_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
# Only for "Connect Discord" on the hacker platform (OAuth2 client secret).
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_HACKER_ROLE_ID=
DISCORD_VERIFICATION_CHANNEL_ID=

# Hacker platform. PLATFORM_BASE_URL is used for the links in its emails and is where
# Discord sends people back to (register "<PLATFORM_BASE_URL>/" as a redirect in the
# Discord Developer Portal). GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET together turn on
# "Continue with Google"; without both there is email and password only. See README, "Hacker platform".
PLATFORM_BASE_URL=https://platform.peachhacks.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This backend's public address. Google sends the browser back to
# <API_BASE_URL>/platform/auth/google/callback, which must be one of the OAuth client's
# Authorized redirect URIs.
API_BASE_URL=https://api.peachhacks.com
# MAX_TEAM_SIZE=4

# Host-school share on the admin Acceptances screen. A school counts as the host when its
# name equals or starts with HOST_SCHOOL_NAME (case-insensitive), so "Georgia State
# University Perimeter College" counts too. HOST_SCHOOL_TARGET is a fraction: 0.70 is 70%.
# HOST_SCHOOL_NAME=Georgia State University
# HOST_SCHOOL_TARGET=0.70

# Eligibility: students of the host school may attend at any age, students of other
# schools must be at least this old. A younger registration from another school is not
# refused; it is flagged for organizers in the admin site.
# NON_HOST_MINIMUM_AGE=18

# Sign-up rate limits: per client address per 10 minutes, and per hour across all
# addresses. Raise the first for a sign-up drive where many people share one network.
# SIGN_UP_LIMIT_PER_ADDRESS=30
# SIGN_UP_LIMIT_PER_HOUR=1000

# Optional
# PORT=8080
# SPRING_DATASOURCE_HIKARI_MAXIMUMPOOLSIZE=5
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://www.peachhacks.com,https://peachhacks.com,https://admin.peachhacks.com
