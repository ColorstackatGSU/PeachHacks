# Copy to .env.local and adjust. Every variable is optional.

# Base URL of the PeachHacks API (no trailing slash).
# Defaults: http://localhost:8080 in `npm run dev`, https://api.peachhacks.com in a build.
VITE_API_BASE_URL=http://localhost:8080

# Dev only: set to 1 to serve fake in-memory data instead of calling the API.
# Ignored by `npm run build`; the mock code is not included in production bundles.
VITE_MOCK_API=0
