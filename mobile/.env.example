# Base URL of the PeachHacks API. Optional.
# Default: https://api.peachhacks.com in a release build. In a development build the
# default is http://10.0.2.2:8080 on Android (the emulator's name for the laptop) and
# http://localhost:8080 on iOS (the simulator shares the laptop's network).
# A physical phone cannot reach the laptop as localhost: set the laptop's LAN address.
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080
